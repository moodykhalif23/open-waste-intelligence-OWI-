
# cp example.env .env
# Generate secrets with:
#     python -c "import secrets; print(secrets.token_urlsafe(32))"

# --- Postgres ---
POSTGRES_USER=owi
POSTGRES_PASSWORD=replace-me-with-a-random-password
POSTGRES_DB=owi

# python -c "import secrets; print(secrets.token_hex(32))"
GARAGE_RPC_SECRET=replace-me-with-64-hex-characters
GARAGE_ADMIN_TOKEN=replace-me-with-64-hex-characters
REDIS_PASSWORD=replace-me-with-64-hex-characters

# --- API ---
# Host-side URL for running the API outside Docker; compose overrides it with
# the in-network one (db:5432).
OWI_DATABASE_URL=postgresql+psycopg://owi:replace-me-with-a-random-password@localhost:5432/owi
OWI_REDIS_URL=redis://:replace-me-with-64-hex-characters@localhost:6379/0
OWI_STORAGE_DRIVER=s3
OWI_S3_ACCESS_KEY=replace-me-with-GK-and-24-hex-characters
OWI_S3_SECRET_KEY=replace-me-with-64-hex-characters
# HS256 needs 32+ characters.
OWI_JWT_SECRET=replace-me-with-a-random-secret-of-32-or-more-characters

OWI_ADMIN_PHONE=+254700000000
OWI_ADMIN_PASSWORD=replace-me-with-a-password
OWI_ADMIN_NAME=Admin
OWI_ORG_NAME=Your Organization

OWI_CORS_ORIGINS=["https://localhost:5173","http://localhost:5174"]
# Where the Vite dev and preview servers proxy /api.
OWI_API_PROXY=http://127.0.0.1:8000
# Baked into a production frontend build that is not same-origin with the API.
# VITE_API_URL=https://api.example.org

OWI_APP_DOMAIN=app.example.org
OWI_DASH_DOMAIN=dash.example.org
OWI_SITE_DOMAIN=example.org

# --- Label Studio ---
LABEL_STUDIO_USERNAME=admin@owi.local
LABEL_STUDIO_PASSWORD=replace-me-with-a-random-password
LABEL_STUDIO_USER_TOKEN=replace-me-with-a-random-hex-token
LABEL_STUDIO_URL=http://localhost:8080

# --- Optional ---
# Region extract for road distances; delete var/osrm/ after changing it.
# OSRM_PBF_URL=https://download.geofabrik.de/africa/kenya-latest.osm.pbf
# Empty disables OSRM entirely (straight-line distances only).
# OWI_OSRM_URL=
# Diesel price, to show KES saved in the savings report; 0 hides it.
# OWI_FUEL_PRICE_KES_PER_L=0
# Notifications — unset credentials fall back to a console/log provider.
# OWI_NOTIFY_CHANNEL=sms
# OWI_AT_USERNAME=
# OWI_AT_API_KEY=
# OWI_AT_SENDER_ID=
# OWI_WA_TOKEN=
# OWI_WA_PHONE_NUMBER_ID=
